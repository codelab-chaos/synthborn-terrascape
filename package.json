{
  "name": "synthborn-terrascape",
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "build:web": "webpack --config webpack.config.cjs",
    "test": "npm run test:web",
    "test:unit": "tsc -p tests/tsconfig.web-unit.json && node --test build/web-unit/tests/web-unit.test.js",
    "test:unit:coverage": "tsc -p tests/tsconfig.web-unit.json && node --test --experimental-test-coverage --test-coverage-include=build/web-unit/src/main/resources/web/src/common/app-state.js --test-coverage-include=build/web-unit/src/main/resources/web/src/common/chunk-planning.js --test-coverage-include=build/web-unit/src/main/resources/web/src/common/entity-feed-policy.js --test-coverage-include=build/web-unit/src/main/resources/web/src/common/entity-summary.js --test-coverage-include=build/web-unit/src/main/resources/web/src/common/map-layer-policy.js --test-coverage-include=build/web-unit/src/main/resources/web/src/common/resource-stats.js --test-coverage-include=build/web-unit/src/main/resources/web/src/common/terrain-requests.js --test-coverage-include=build/web-unit/src/main/resources/web/src/common/terrain-stream.js --test-coverage-include=build/web-unit/src/main/resources/web/src/common/view-preferences.js --test-coverage-exclude=build/web-unit/tests/*.js build/web-unit/tests/web-unit.test.js",
    "test:web": "npm run build:web && playwright test tests/terrascape.spec.js",
    "test:java": "sh gradlew test",
    "test:release": "npm run test:java && npm run test:unit && npm run test:web",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "perf": "node tools/run-terrascape-perf.js --both",
    "perf:dry": "node tools/run-terrascape-perf.js --dry",
    "perf:wet": "node tools/run-terrascape-perf.js --wet",
    "perf:smoke": "node tools/run-terrascape-perf.js --quick --dry --runs 1",
    "perf:radius": "node tools/run-terrascape-perf.js --extensive --config tools/perf-suite-radius-sweep.json --dry --runs 1",
    "perf:mob": "node tools/run-terrascape-mob-view-perf.js",
    "perf:extensive": "node tools/run-terrascape-perf.js --extensive --runs 2",
    "perf:extensive:wet": "node tools/run-terrascape-perf.js --extensive --wet --runs 2",
    "deploy": "node tools/deploy.js restart",
    "deploy:status": "node tools/deploy.js status",
    "deploy:logs": "node tools/deploy.js logs -n 120",
    "deploy:combined": "node tools/deploy.js --target combined restart",
    "deploy:combined:local": "node tools/deploy.js --target combined --local restart",
    "perf:postdeploy": "node tools/run-terrascape-perf.js --post-deploy --both",
    "perf:postdeploy:extensive": "node tools/run-terrascape-perf.js --post-deploy --extensive --runs 2 --clear-server-cache",
    "probe": "node tools/probe-blocks.js",
    "parse-client-log": "node tools/parse-client-log.js",
    "perf:baseline": "node tools/run-terrascape-baseline.js"
  },
  "keywords": [],
  "author": "Chad Neff",
  "license": "MIT",
  "type": "commonjs",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "three": "^0.184.0",
    "ts-loader": "^9.6.0",
    "typescript": "^6.0.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  }
}
