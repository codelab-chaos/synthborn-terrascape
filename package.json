{
  "name": "synthborn-terrascape",
  "version": "0.1.1-beta.2",
  "main": "index.js",
  "scripts": {
    "build:web": "webpack --config webpack.config.cjs",
    "test": "npm run test:java && npm run test:web",
    "test:java": "sh gradlew test",
    "test:web": "tsc -p tsconfig.json --noEmit && node -e \"require('node:fs').rmSync('build/web-unit',{recursive:true,force:true})\" && tsc -p tests/tsconfig.web-unit.json && node --import ./tests/web-unit-setup.mjs --test \"build/web-unit/tests/web-unit/**/*.test.js\"",
    "test:unit": "npm run coverage",
    "test:unit:coverage": "node tools/web-coverage.cjs",
    "coverage:java": "sh gradlew test jacocoTestReport && node tools/jacoco-jest-report.cjs",
    "coverage": "npm run test:unit:coverage && npm run coverage:java",
    "test:release": "npm run test:java && npm run test:web && npm run testlive",
    "testlive": "npm run build:web && playwright test tests/e2e/terrascape.spec.js",
    "testlive:headed": "playwright test --headed",
    "testlive:ui": "playwright test --ui",
    "runtime:smoke": "node tools/run-terrascape-runtime-smoke.js",
    "perf": "node tools/run-terrascape-perf.js --both",
    "perf:dry": "node tools/run-terrascape-perf.js --dry",
    "perf:wet": "node tools/run-terrascape-perf.js --wet",
    "perf:smoke": "node tools/run-terrascape-perf.js --quick --dry --runs 1",
    "perf:render": "node tools/run-terrascape-perf.js --extensive --config tools/perf-suite-bounded-render.json --both --runs 2",
    "perf:render:stationary": "node tools/run-terrascape-perf.js --extensive --config tools/perf-suite-stationary-render.json --both --runs 2",
    "perf:desktop": "node tools/run-terrascape-desktop-perf.cjs",
    "perf:desktop:launch": "node tools/launch-terrascape-desktop-perf.cjs",
    "perf:desktop:auto": "node tools/launch-terrascape-desktop-perf.cjs --run",
    "perf:radius": "node tools/run-terrascape-perf.js --extensive --config tools/perf-suite-radius-sweep.json --dry --runs 1",
    "perf:mob": "node tools/run-terrascape-mob-view-perf.js",
    "perf:extensive": "node tools/run-terrascape-perf.js --extensive --runs 2",
    "deploy": "node tools/deploy.js restart",
    "deploy:status": "node tools/deploy.js status",
    "deploy:logs": "node tools/deploy.js logs -n 120",
    "deploy:combined": "node tools/deploy.js --target combined restart",
    "deploy:combined:local": "node tools/deploy.js --target combined --local restart",
    "perf:postdeploy": "node tools/run-terrascape-perf.js --post-deploy --both",
    "probe": "node tools/probe-blocks.js",
    "parse-client-log": "node tools/parse-client-log.js",
    "perf:baseline": "node tools/run-terrascape-baseline.js",
    "perf:report": "node tools/serve-metrics.js",
    "roadmap:setup": "playwright install chromium",
    "roadmap": "node tools/generate-roadmap.cjs"
  },
  "keywords": [],
  "author": "Chad Neff",
  "license": "MIT",
  "type": "commonjs",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "c8": "^11.0.0",
    "happy-dom": "^20.10.6",
    "three": "^0.184.0",
    "ts-loader": "^9.6.0",
    "typescript": "^6.0.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  }
}
