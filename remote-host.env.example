# Copy to remote-host.env in this repo root.
# The deploy scripts read this file directly; basecamp is not required.
# Remote/headless Hytale authentication policy: use `/auth login device`, then confirm
# `/auth status` reports `Token Source: OAuth Device`. Do not use browser callback auth.

HYTALE_REMOTE_SSH=hytale-mac
HYTALE_REMOTE_HOST=macbook-server.org
HYTALE_REMOTE_USER=chadneff
HYTALE_REMOTE_SAVES="/Users/chadneff/Library/Application Support/Hytale/UserData/Saves"
HYTALE_REMOTE_INSTALL="$HOME/Library/Application Support/Hytale/install/release/package"

# Host used by local RCON health checks.
SYNTH_RCON_HOST=macbook-server.org

# Required for deploy commands that execute RCON commands.
# Match this to rcon.password in the server's terrascape.properties file.
# SYNTH_RCON_PASSWORD=

# Optional local server overrides for `node tools/deploy.js --local ...`.
# If unset, the deploy script uses platform Hytale defaults.
# HYTALE_LOCAL_SAVES="/path/to/Hytale/UserData/Saves"
# HYTALE_LOCAL_INSTALL="/path/to/Hytale/install/release/package"

# Integration target:
#   node tools/deploy.js --target combined restart
#   node tools/deploy.js --target combined --local restart
# Save: synthborn-combined
# Game: 0.0.0.0:5522
# RCON: 25579
# Terrascape HTTP: 5961
