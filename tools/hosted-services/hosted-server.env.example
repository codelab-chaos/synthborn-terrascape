# Copy to tools/hosted-services/hosted-server.env. The local file is gitignored.
#
# Hosted-server validation profile example. HOSTING_SERVICE is a typed provider selector;
# currently supported: apex.

HOSTING_SERVICE=apex
HOSTING_INSTANCE_NAME=Example Hosted Validation Server

# Public game endpoint, for release evidence only.
HOSTING_GAME_HOST=203.0.113.10
HOSTING_GAME_PORT=25565

# Public Terrascape endpoints assigned by the hosting provider.
HOSTING_PUBLIC_HOST=203.0.113.10
HOSTING_TERRASCAPE_WEB_PORT=7656
HOSTING_TERRASCAPE_RCON_PORT=6225
# Optional map-link URL shown by /terrascape maplink. Use a DNS/CNAME/custom domain
# here when you do not want generated links to expose the numeric host IP.
# HOSTING_TERRASCAPE_PUBLIC_BASE_URL=http://map.example.com:7656

# FTP upload endpoint from the hosting provider's file manager.
HOSTING_FTP_HOST=example.node.provider.test
HOSTING_FTP_PORT=21
HOSTING_FTP_USER=your-hosting-ftp-user
HOSTING_FTP_PASSWORD=

# Apex FTP login starts one directory above the server root.
HOSTING_FTP_ROOT=default
HOSTING_LOG_DIR=logs

# Terrascape runtime config generated and uploaded by tools/hosted-services/deploy.js upload-config.
HOSTING_TERRASCAPE_ACCESS_MODE=restricted
HOSTING_TERRASCAPE_RCON_PASSWORD=
HOSTING_TERRASCAPE_SMOKE_TOKENS_ENABLED=true
