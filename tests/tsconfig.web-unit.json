{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "rootDir": "..",
    "outDir": "../build/web-unit",
    "strict": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "noEmitOnError": false
  },
  "include": [
    "web-unit/**/*.test.ts",
    "../web/src/**/*.ts"
  ]
}
